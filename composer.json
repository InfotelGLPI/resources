{
    "config": {
        "platform": {
            "php": "8.2.99",
            "ext-ldap": "8.2"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "glpi-project/tools": "^0.8",
        "friendsofphp/php-cs-fixer": "^3.95",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "glpi-project/phpstan-glpi": "^1.3",
        "phpunit/phpunit": "^11.5"
    },
    "require": {
        "php": ">=8.2",
        "directorytree/ldaprecord": "^4.0"
    },
    "replace": {
        "psr/clock": "1.0.0",
        "psr/container": "1.1.2",
        "psr/log": "3.0.2",
        "psr/simple-cache": "3.0.0",
        "symfony/deprecation-contracts": "3.7.0",
        "symfony/polyfill-mbstring": "1.38.1",
        "symfony/polyfill-php83": "1.38.1",
        "symfony/polyfill-php84": "1.37.0",
        "symfony/translation-contracts": "3.7.0"
    },
    "scripts": {
        "lint": "parallel-lint --exclude vendor --exclude node_modules .",
        "cs": "php-cs-fixer fix --dry-run --diff --ansi",
        "cs-fix": "php-cs-fixer fix --ansi",
        "phpstan": "phpstan analyze --ansi --memory-limit=1G",
        "qa": [
            "@lint",
            "@phpstan",
            "@cs"
        ]
    }
}
