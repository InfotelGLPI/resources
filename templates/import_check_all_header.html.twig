{# Header cell holding the "check all" box; the checkAll() helper is emitted
 # alongside this template. #}
<th>
    <div class="form-group-checkbox">
        <input type="checkbox" class="new_checkbox" name="checkall_imports" id="checkall_imports"
               title="{{ __('Check all') }}" onclick="checkAll(this.checked);">
        <label class="label-checkbox" for="checkall_imports" title="{{ __('Check all') }}">
            <span class="check"></span>
            <span class="box"></span>
        </label>
    </div>
</th>
