{# AJAX fragment injected into #plugin_resources_badge (resourcebadge_wizard.html.twig):
 # the badges of the chosen resource. badge_dropdown is a widget rendered by
 # Badge::dropdown(), which escapes its own attributes and values. #}
<div class="row mb-3 align-items-center">
    <label class="col-12 col-md-3 col-form-label">{{ badge_label }}</label>
    <div class="col-12 col-md-9">
        {% if has_user %}
            {{ badge_dropdown|raw }}
        {% else %}
            <div class="alert alert-info mb-0">
                <i class="ti ti-info-circle me-2"></i>{{ __('No user is linked to this resource', 'resources') }}
            </div>
        {% endif %}
    </div>
</div>
