<div id="plugin_resources_container">
    <div id="plugin_resources_card">
        <div id="plugin_resources_card-header">
            {% if has_user %}
                <div id="plugin_resources_card-header-button"
                     data-download="{{ vcard_url }}"
                     class="download mouse-events"></div>
            {% endif %}
        </div>

        <div id="plugin_resources_card-content">
            <div id="plugin_resources_card-content-frame">
                <div id="plugin_resources_card-content-wrap">
                    {% include '@resources/resourcecard_identity.html.twig' with {'identity': identity} only %}
                </div>

                {% if has_user %}
                    {% include '@resources/resourcecard_items.html.twig' with {'items': items} only %}
                {% endif %}
            </div>
        </div>
    </div>

    <div id="plugin_resources_card-footer"></div>
</div>

{% if has_user %}
    <nav>
        <ul class="plugin_resources_clearfix">
            <li class="active"><a href="{{ card_url }}#about">{{ __('About', 'resources') }}</a></li>
            <li><a href="{{ card_url }}#inventory">{{ __('Inventory', 'resources') }}</a></li>
        </ul>
    </nav>
{% endif %}
