{# Tooltip body: Html::showToolTip() injects it raw, so every value is escaped here. #}
<table class="tab_cadre_fixe">
    {% if title is not empty %}
        <tr>
            <th>{{ title }}</th>
        </tr>
    {% endif %}
    <tbody>
        {% for row in rows %}
            <tr>
                <td class="center">{{ row.title }}</td>
                <td class="center">{{ row.value }}</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
