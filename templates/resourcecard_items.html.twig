<div id="plugin_resources_inventory" class="plugin_resources_content text-start">
    <h1>{{ __('Inventory', 'resources') }}</h1>

    <div class="scrollable" style="padding-right: 8px;height:420px;">
        {% for group in items %}
            <table class="tab_cadre_fixe">
                <tr>
                    <td colspan="3" class="center b">{{ group.type_name }}</td>
                </tr>
                {% for row in group.rows %}
                    <tr class="tab_bg_1">
                        <td class="center" width="100">
                            <img src="{{ row.picture }}" width="50%" alt="" />
                        </td>
                        <td class="left">
                            {% if row.url %}
                                <a href="{{ row.url }}">{{ row.label }}</a>
                            {% else %}
                                {{ row.label }}
                            {% endif %}
                            <br />
                            {% for detail in row.details %}
                                {{ detail }}<br />
                            {% endfor %}
                        </td>
                    </tr>
                {% endfor %}
            </table>
        {% else %}
            <div class="alert alert-important alert-warning d-flex">
                <b>{{ __('No results found') }}</b>
            </div>
        {% endfor %}
    </div>
</div>
