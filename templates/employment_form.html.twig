{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% block form_fields %}
    {{ fields.autoNameField('name', item, __('Name'), withtemplate, field_options) }}

    {{ fields.dropdownField(
        employer_class,
        'plugin_resources_employers_id',
        item.fields['plugin_resources_employers_id'],
        __('Employer', 'resources'),
        {'entity': item.fields['entities_id']|default(-1)}
    ) }}

    {# Profession drives an AJAX refresh of the rank span, and Rank is read-only
     # here (it follows the selected profession), so neither fits dropdownField. #}
    {{ fields.htmlField(
        'plugin_resources_professions_id',
        profession_dropdown,
        __('Profession', 'resources'),
        {'wrapper_class': ''}
    ) }}

    {{ fields.htmlField(
        'plugin_resources_ranks_id',
        rank_html,
        __('Rank', 'resources')
    ) }}

    {{ fields.dropdownField(
        employmentstate_class,
        'plugin_resources_employmentstates_id',
        item.fields['plugin_resources_employmentstates_id'],
        __('Employment state', 'resources'),
        {'entity': item.fields['entities_id']|default(-1)}
    ) }}

    {{ fields.textField(
        'ratio_employment_budget',
        ratio_value,
        __('Ratio Employment / Budget', 'resources')
    ) }}

    {{ fields.dateField('begin_date', item.fields['begin_date'], __('Begin date')) }}

    {{ fields.dateField('end_date', item.fields['end_date'], __('End date')) }}

    {# On creation the resource comes from the options, not from the item fields. #}
    {{ fields.dropdownField(
        resource_class,
        'plugin_resources_resources_id',
        resource_value,
        __('Human resource', 'resources'),
        {'entity': item.fields['entities_id']|default(-1)}
    ) }}

    {{ fields.textareaField('comment', item.fields['comment'], __('Comments')) }}
{% endblock %}
