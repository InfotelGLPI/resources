{# Table-row fragment: emitted inside the import list table, whose surrounding form
 # dispatches on save / delete. #}
<tr>
    <td class="center" colspan="100">
        {{ call('Html::submit', [_x('button', 'Save'), {
            'name': 'save',
            'class': 'btn btn-primary',
        }])|raw }}
        &nbsp;&nbsp;
        {{ call('Html::submit', [_x('button', 'Remove an item'), {
            'name': 'delete',
            'class': 'btn btn-primary',
        }])|raw }}
    </td>
</tr>
