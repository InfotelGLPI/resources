{# The |raw values below are widgets rendered by core helpers (Dropdown::*, Html::input,
 # Html::textarea, Html::showDate*Field, Html::submit...), which escape their own
 # attributes and values. #}

<div class="center">
    {% if show_form %}
        <form method="post" action="{{ form_action }}">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    {% endif %}
    <table class="tab_cadre_fixe">
        <tr>
            <th colspan="4">{{ title }}</th>
        </tr>
        {% if show_created_note %}
            <tr class="tab_bg_1">
                <td colspan="4" class="center">{{ created_note }}</td>
            </tr>
        {% endif %}
        <tr class="tab_bg_1">
            <td colspan="2" class="center">
                <input type="hidden" name="plugin_resources_resources_id" value="{{ resources_id }}">
                {{ label_employer }}
            </td>
            <td colspan="2">{{ employer_dropdown|raw }}</td>
        </tr>
        <tr class="tab_bg_1">
            <td colspan="2" class="center">{{ label_address }}</td>
            <td colspan="2"><span id="span_location" name="span_location">{{ address_html }}</span></td>
        </tr>
        <tr class="tab_bg_1">
            <td colspan="2" class="center">{{ label_client }}</td>
            <td>{{ client_dropdown|raw }}</td>
            <td>
                <div id="security_compliance">
                    {% include '@resources/employee_security_compliance.html.twig' with {'compliant': compliant} only %}
                </div>
            </td>
        </tr>
        <tr>
            <td class="tab_bg_2 top" colspan="4">
                {% if buttons is not empty %}
                    {% if buttons.mode == 'update' %}
                        <input type="hidden" name="id" value="{{ buttons.id }}">
                    {% endif %}
                    <input type="hidden" name="plugin_resources_resources_id" value="{{ buttons.resources_id }}">
                    <div class="center">
                        {% if buttons.mode == 'add' %}
                            <button type="submit" name="addemployee" value="1" class="btn btn-primary">
                                {{ _x('button', 'Add') }}
                            </button>
                        {% elseif buttons.mode == 'add_with_resource' %}
                            {# Template dropdown rendered by the core helper (Resource::dropdownTemplate). #}
                            {{ buttons.template_dropdown|raw }}
                            <input type="hidden" name="users_id" value="{{ buttons.users_id }}">
                            <button type="submit" name="addressourceandemployee" value="1" class="btn btn-primary">
                                {{ _x('button', 'Add') }}
                            </button>
                        {% else %}
                            <button type="submit" name="updateemployee" value="1" class="btn btn-primary me-5">
                                {{ _x('button', 'Update') }}
                            </button>
                            <button type="submit" name="deleteemployee" value="1" class="btn btn-primary">
                                {{ _x('button', 'Delete permanently') }}
                            </button>
                        {% endif %}
                    </div>
                {% endif %}
            </td>
        </tr>
    </table>
    {% if show_form %}
        </form>
    {% endif %}
</div>
