<div class="center">
    {% if show_form %}
        <form method="post" action="{{ form_action }}">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    {% endif %}
    <table class="tab_cadre_fixe">
        <tr>
            <th colspan="4">{{ title }}</th>
        </tr>
        {% if show_created_note %}
            <tr class="tab_bg_1">
                <td colspan="4" class="center">{{ created_note }}</td>
            </tr>
        {% endif %}
        <tr class="tab_bg_1">
            <td colspan="2" class="center">{{ hidden_resources_id|raw }}{{ label_employer }}</td>
            <td colspan="2">{{ employer_dropdown|raw }}</td>
        </tr>
        <tr class="tab_bg_1">
            <td colspan="2" class="center">{{ label_address }}</td>
            <td colspan="2"><span id="span_location" name="span_location">{{ address_html }}</span></td>
        </tr>
        <tr class="tab_bg_1">
            <td colspan="2" class="center">{{ label_client }}</td>
            <td>{{ client_dropdown|raw }}</td>
            <td>
                <div id="security_compliance">
                    {% include '@resources/employee_security_compliance.html.twig' with {'compliant': compliant} only %}
                </div>
            </td>
        </tr>
        <tr>
            <td class="tab_bg_2 top" colspan="4">{{ buttons_cell|raw }}</td>
        </tr>
    </table>
    {% if show_form %}
        </form>
    {% endif %}
</div>
