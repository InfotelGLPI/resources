{# Read only catalog of the variables usable in the ticket text of the validation module.
 # Loaded in a modal from the plugin configuration form. #}
<div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>{{ __('Variable', 'resources') }}</th>
                <th>{{ __('Description', 'resources') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for variable, description in variables %}
                <tr>
                    <td><code>{{ variable }}</code></td>
                    <td>{{ description }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
