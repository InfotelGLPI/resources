{# Standalone form: front/resourcehabilitation.form.php dispatches on `add`, and the
 # list below is rendered separately by the datatable component. #}
<form name="form" method="post" action="{{ form_action }}">
    <div class="center">
        <table class="tab_cadre_fixe">
            <tr class="tab_bg_1">
                <th colspan="2">{{ __('Add additional habilitation', 'resources') }}</th>
            </tr>
            <tr class="tab_bg_1">
                <td class="center">{{ habilitation_label }}</td>
                <td class="center">{{ habilitation_dropdown|raw }}</td>
            </tr>
            <tr class="tab_bg_1">
                <td colspan="2" class="tab_bg_2 center">
                    <input type="hidden" name="plugin_resources_resources_id" value="{{ resources_id }}">
                    {{ call('Html::submit', [_x('button', 'Add'), {
                        'name': 'add',
                        'class': 'btn btn-primary',
                    }])|raw }}
                </td>
            </tr>
        </table>
    </div>
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
</form>
