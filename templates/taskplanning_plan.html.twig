{# `label` is built server-side: either a date range (which carries &nbsp; entities)
 # or an already-escaped caption, hence |raw. #}
{% if can_create %}
    <div id="plan" onclick="{{ js_function }}();">
        <span class="showplan">{{ label|raw }}</span>
    </div>
    <div id="viewplan"></div>
{% else %}
    {{ label|raw }}
{% endif %}
