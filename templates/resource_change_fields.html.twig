{# Label/widget rows shared by every branch of Resource_Change::setFieldByAction().
 # Widgets are GLPI dropdowns/inputs already rendered server-side, hence |raw;
 # plain text put in a widget must be escaped by the caller. #}
{% for row in rows %}
    <div class="{{ row_class|default('row') }}">
        <div class="{{ cell_class|default('col-md-4 mb-2') }}">{{ row.label }}</div>
        <div class="{{ cell_class|default('col-md-4 mb-2') }}">{{ row.widget|raw }}</div>
    </div>
{% endfor %}
