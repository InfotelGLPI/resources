{# Shared by the Actionprofile and Contracttypeprofile blocks of the Profile tab:
 # a standalone form holding a single multi-select plus its save button. Each caller
 # provides its own form action and submit name, which its front controller
 # dispatches on. #}
<form method="post" action="{{ form_action }}">
    <input type="hidden" name="profiles_id" value="{{ profiles_id }}">
    <table class="tab_cadre_fixe">
        <tr class="tab_bg_1">
            <th colspan="4">{{ title }}</th>
        </tr>
        <tr class="tab_bg_1">
            <td>{{ label }}</td>
            <td>{{ dropdown|raw }}</td>
        </tr>
        <tr class="tab_bg_2">
            <td colspan="4" class="center">
                {{ call('Html::submit', [_x('button', 'Save'), {
                    'name': submit_name,
                    'class': 'btn btn-primary',
                }])|raw }}
            </td>
        </tr>
    </table>
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
</form>
