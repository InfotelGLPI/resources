{# Already escaped in PHP (htmlescape then nl2br), so the <br> tags survive. #}
<div id="commentneed{{ items_id }}{{ rand }}" class="center" onclick="showComment{{ items_id }}()">
    {{ comment|raw }}
</div>

<div id="viewcommentneed{{ items_id }}{{ rand }}"></div>

<div id="viewaccept{{ items_id }}{{ rand }}" style="display:none;" class="center">
    <p>
        <input type="submit" name="updateneedcomment[{{ items_id }}]"
               value="{{ _x('button', 'Update') }}" class="submit btn btn-primary">
        &nbsp;
        <input type="button" onclick="hideForm{{ items_id }}();"
               value="{{ _x('button', 'Cancel') }}" class="submit btn btn-primary">
    </p>
</div>
