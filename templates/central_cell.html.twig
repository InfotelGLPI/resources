{# One cell of central_datatable.html.twig, built from raw values:
 #  - link:      {url, label}
 #  - date:      {class, text}
 #  - lines:     list of strings, one per line
 #  - checklist: list of {label, tag}, see checklist_central_sublist.html.twig #}
{% if kind == 'link' %}
    <a href="{{ value.url }}">{{ value.label }}</a>
{% elseif kind == 'date' %}
    <div class="{{ value.class }}">{{ value.text }}</div>
{% elseif kind == 'lines' %}
    {% for line in value %}
        <div>{{ line }}</div>
    {% endfor %}
{% elseif kind == 'checklist' %}
    {{ include('@resources/checklist_central_sublist.html.twig', {entries: value}, with_context = false) }}
{% endif %}
