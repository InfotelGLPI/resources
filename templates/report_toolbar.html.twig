{# Export bar of the reports, rendered by ReportExport::showToolbar(). The posted report
 # criteria are replayed as hidden fields so the export runs on the same selection. #}
{% if total == 0 %}
    <div class="alert alert-danger center">{{ __('No results found') }}</div>
{% else %}
    <div class="center">
        <table class="tab_cadre_fixe">
            <tr><th>{{ title }}</th></tr>
            <tr class="tab_bg_2 center">
                <td class="center">
                    <form method="post" action="{{ action }}">
                        {% for field in hidden_fields %}
                            <input type="hidden" name="{{ field.name }}" value="{{ field.value }}">
                        {% endfor %}
                        {# Dropdown::showOutputFormat() echoes the core export selector and its button. #}
                        {{ output_format|raw }}
                    </form>
                </td>
            </tr>
        </table>
    </div>
{% endif %}
