<div id="plugin_resources_about" class="plugin_resources_content plugin_resources_clearfix">
    {% if not identity.has_user %}
        <p><span class="b red">{{ __('Information, this resource is not linked to a user', 'resources') }}</span></p>
    {% endif %}

    <div id="plugin_resources_about-image">
        <img src="{{ identity.picture_url }}" alt="" />
    </div>

    <div id="plugin_resources_about-content" class="text-start">
        <h1>{{ identity.title }}</h1>
        {% if identity.subtitle is not empty %}
            <h2>{{ identity.subtitle }}</h2>
        {% endif %}

        <div style="height:10px;"></div>

        <div class="scrollable" style="padding-right: 8px;height:420px;">
            <p>
                {% for info in identity.infos %}
                    <span class="b">{{ __('%1$s: %2$s')|format(info.label, '') }}</span>{{ info.value }}<br />
                {% endfor %}

                {% if identity.emails is not empty %}
                    <span class="b">{{ _n('Email', 'Emails', identity.emails|length) }}</span>&nbsp;:&nbsp;{{ identity.emails|join(', ') }}
                {% endif %}
            </p>

            <p>
                <span class="b">{{ __('%1$s: %2$s')|format(__('Arrival date', 'resources'), '') }}</span>{{ identity.arrival_date }}
            </p>

            {% if identity.habilitations is not empty %}
                <h3>{{ identity.habilitations_title }}</h3>
                <table class="tab_cadre_fixe">
                    <tr>
                        <th class="text-center">{{ __('Name') }}</th>
                    </tr>
                    {% for habilitation in identity.habilitations %}
                        <tr class="tab_bg_1">
                            <td class="center">{{ habilitation }}</td>
                        </tr>
                    {% endfor %}
                </table>
            {% endif %}
        </div>
    </div>
</div>
