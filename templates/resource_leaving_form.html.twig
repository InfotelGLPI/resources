{# Standalone form: front/resource.form.php dispatches on validOrderLeaving, so the
 # generic form buttons component cannot be used here. The submit is only offered
 # while no order has been given yet. #}
<form name="form" method="post" action="{{ form_action }}">
    <div class="center">
        <table class="tab_cadre_fixe">
            <tr class="tab_bg_1">
                <th colspan="2">{{ __('Give a leaving order', 'resources') }}</th>
            </tr>
            <tr class="tab_bg_1">
                <td class="tab_bg_2">{{ __('Departure date', 'resources') }}</td>
                <td class="tab_bg_2">{{ date_end_input|raw }}</td>
            </tr>
            <tr class="tab_bg_1">
                <td class="tab_bg_2">{{ __('Order', 'resources') }}</td>
                <td class="tab_bg_2 center">
                    <input type="hidden" name="plugin_resources_resources_id" value="{{ resources_id }}">
                    {{ order_textarea|raw }}
                </td>
            </tr>
            <tr class="tab_bg_1">
                <td colspan="2" class="tab_bg_2 center">
                    {% if can_validate %}
                        {{ call('Html::submit', [validate_label, {
                            'name': 'validOrderLeaving',
                            'class': 'btn btn-primary',
                        }])|raw }}
                    {% endif %}
                </td>
            </tr>
        </table>
    </div>
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
</form>
