{# Security compliance flag of the client of an employee. Rendered on page load next to the
 # client dropdown and sent back by ajax/employee.php whenever that dropdown changes, so
 # both paths produce the same markup. #}
<label class="col-form-label col-xxl-5 text-xxl-end">
    <span class="{{ compliant ? 'text-success' : 'text-danger' }}">
        {{ __('Security compliance', 'resources') }}&nbsp;
        <i class="ti {{ compliant ? 'ti-circle-check' : 'ti-circle-x' }}"
           title="{{ compliant ? __('OK') : __('KO') }}"></i>
    </span>
</label>
