{# Header row of an import list, shared by the import list and both verification
 # reports. `columns` is built by ImportResource::getListHeaderColumns(). #}
<tr>
    {% for column in columns %}
        {% if column.type|default('') == 'check_all' %}
            <th>
                {# Handled by public/scripts/import.js: it ticks every box of this form. #}
                <div class="form-group-checkbox">
                    <input type="checkbox" class="new_checkbox" name="checkall_imports" id="checkall_imports"
                           title="{{ __('Check all') }}">
                    <label class="label-checkbox" for="checkall_imports" title="{{ __('Check all') }}">
                        <span class="check"></span>
                        <span class="box"></span>
                    </label>
                </div>
            </th>
        {% elseif column.type|default('') == 'file' %}
            <th>
                <img src="{{ column.icon }}" alt="{{ column.icon_title }}" title="{{ column.icon_title }}"
                     width="30" height="30" style="vertical-align: middle;">
                <span style="vertical-align: middle;">{{ column.label }}</span>
            </th>
        {% else %}
            <th>{{ column.label }}</th>
        {% endif %}
    {% endfor %}
</tr>
