{# Plain select listing the items already linked to a resource, so one of them can be
 # attached to a task. The option value pairs the item id with its itemtype, which is
 # what Task_Item expects back. Item names are user supplied: never render them raw. #}
<select class="form-select" name="{{ field_name }}">
    <option value="0" selected>{{ empty_value }}</option>
    {% for option in options %}
        <option value="{{ option.value }}">{{ option.label }}</option>
    {% endfor %}
</select>
