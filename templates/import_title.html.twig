<div class="center mb-3">
    {% if links %}
        <a href="{{ index_url }}" class="btn btn-primary me-2" title="{{ __('List of Imports', 'resources') }}">
            <i class="ti ti-list me-1"></i>{{ title }}
        </a>
        {% if can_create %}
            <a href="{{ form_url }}" class="btn btn-primary"
               title="{{ __('Add an Import', 'resources') }}"
               aria-label="{{ __('Add an Import', 'resources') }}">
                <i class="ti ti-plus"></i>
            </a>
        {% endif %}
    {% else %}
        <h2>{{ title }}</h2>
    {% endif %}
</div>
