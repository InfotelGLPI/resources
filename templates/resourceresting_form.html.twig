{# Declaration or detail of a non contract period (ResourceResting::showForm()).
 # Standalone form: the submit names below (addrestingresources, ...) are the ones
 # front/resourceresting.form.php dispatches on, so the generic form buttons component
 # (which emits add/update/delete) cannot be used here. #}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% set field_options = {'is_horizontal': false, 'field_class': 'col-12 col-md-6'} %}

<div class="container-lg my-3">
    <form method="post" action="{{ form_action }}" class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="{{ wizard_header.icon }} me-2"></i>{{ wizard_header.title }}
            </h3>
            <div class="card-actions">
                <a href="./resourceresting.php" class="btn btn-ghost-secondary">
                    <i class="ti ti-list-details me-1"></i>{{ __('List of non contract periods', 'resources') }}
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                {{ fields.dropdownField(
                    resource_class,
                    'plugin_resources_resources_id',
                    item.fields['plugin_resources_resources_id'],
                    resource_label,
                    field_options|merge({'entity': resource_entities, 'field_class': 'col-12'})
                ) }}

                {{ fields.dateField('date_begin', item.fields['date_begin'], __('Begin date'), field_options) }}

                {{ fields.dateField('date_end', item.fields['date_end'], __('End date'), field_options) }}

                {{ fields.dropdownField(
                    location_class,
                    'locations_id',
                    item.fields['locations_id'],
                    __('Agency concerned', 'resources'),
                    field_options
                ) }}

                {{ fields.dropdownYesNo('at_home', item.fields['at_home'], __('At home', 'resources'), field_options) }}

                {{ fields.textareaField('comment', item.fields['comment'], __('Comments'), field_options|merge({'field_class': 'col-12'})) }}
            </div>
        </div>
        <div class="card-footer d-flex flex-wrap gap-2 justify-content-end">
            {% if is_new %}
                <button type="submit" name="addrestingresources" value="1" class="btn btn-primary">
                    <i class="ti ti-plus me-1"></i>{{ _x('button', 'Add') }}
                </button>
            {% else %}
                <input type="hidden" name="id" value="{{ item.fields['id'] }}">
                <button type="submit" name="deleterestingresources" value="1" class="btn btn-outline-danger me-auto">
                    <i class="ti ti-trash me-1"></i>{{ _x('button', 'Delete permanently') }}
                </button>
                <button type="submit" name="updaterestingresources" value="1" class="btn btn-primary">
                    <i class="ti ti-device-floppy me-1"></i>{{ _x('button', 'Update') }}
                </button>
            {% endif %}
        </div>
    </form>
</div>
