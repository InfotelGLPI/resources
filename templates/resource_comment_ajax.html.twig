{# Comment fragment served by ajax/comments.php to the resource dropdown.
 #
 # `link_script` is an inline <script> because the fragment is injected with jQuery
 # .load(), which evaluates the scripts it finds in the response: there is no static
 # file that could carry the per-request element id and href. It is built in PHP with
 # json_encode(JSON_HEX_TAG | JSON_HEX_AMP), so it cannot break out of the block. #}

{{ comment }}

{% if link_script %}
    <script type="text/javascript">{{ link_script|raw }}</script>
{% endif %}
