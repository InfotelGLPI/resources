{% import 'components/form/fields_macros.html.twig' as fields %}

{# Standalone form: the submit names below (addholidayresources, ...) are the ones
 # front/resourceholiday.form.php dispatches on, so the generic form buttons
 # component (which emits add/update/delete) cannot be used here. #}
<div class="card container" style="min-width: 80%;">
    {{ wizard_header|raw }}

    <div class="card-body">
        <form method="post" action="{{ form_action }}">
            <div class="row">
                {{ fields.dropdownField(
                    resource_class,
                    'plugin_resources_resources_id',
                    item.fields['plugin_resources_resources_id'],
                    resource_label,
                    {'entity': resource_entities}
                ) }}

                {{ fields.dateField('date_begin', item.fields['date_begin'], __('Begin date')) }}

                {{ fields.dateField('date_end', item.fields['date_end'], __('End date')) }}

                {{ fields.textareaField('comment', item.fields['comment'], __('Comments')) }}
            </div>

            <div class="row">
                <div class="col-md-12 mb-2">
                    <div class="preview">
                        <a href="./resourceholiday.form.php">{{ __('Declare a forced holiday', 'resources') }}</a>
                        &nbsp;/&nbsp;
                        <a href="./resourceholiday.php">{{ __('List of forced holidays', 'resources') }}</a>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12 mb-2">
                    <div class="next">
                        {% if is_new %}
                            {{ call('Html::submit', [_x('button', 'Add'), {
                                'name': 'addholidayresources',
                                'class': 'btn btn-success',
                            }])|raw }}
                        {% else %}
                            <input type="hidden" name="id" value="{{ item.fields['id'] }}">
                            {{ call('Html::submit', [_x('button', 'Update'), {
                                'name': 'updateholidayresources',
                                'class': 'btn btn-primary',
                            }])|raw }}
                            &nbsp;&nbsp;
                            {{ call('Html::submit', [_x('button', 'Delete permanently'), {
                                'name': 'deleteholidayresources',
                                'class': 'btn btn-primary',
                            }])|raw }}
                        {% endif %}
                    </div>
                </div>
            </div>

            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
        </form>
    </div>
</div>
