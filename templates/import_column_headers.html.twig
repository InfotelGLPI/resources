{# One header cell per import column, flagged as coming from the CSV file. #}
{% for column in columns %}
    <th>
        <img src="{{ icon }}" alt="{{ icon_title }}" title="{{ icon_title }}"
             width="30" height="30" style="vertical-align: middle;">
        <span style="vertical-align: middle;">{{ column }}</span>
    </th>
{% endfor %}
