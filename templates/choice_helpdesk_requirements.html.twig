<form method="post" action="{{ form_action }}">
    <div class="center">
        <table class="tab_cadre_fixe">
            <tr>
                <th colspan="4">{{ __('Specials requirements', 'resources') }}</th>
            </tr>

            {% for field in textareas %}
                <tr class="tab_bg_1">
                    <td>{{ field.label }}</td>
                    <td>{{ field.textarea|raw }}</td>
                </tr>
            {% endfor %}

            <tr class="tab_bg_1">
                <td class="center" colspan="2">
                    <input type="hidden" name="plugin_resources_resources_id" value="{{ resources_id }}">
                    {% if can_save %}
                        {{ call('Html::submit', [_x('button', 'Save'), {
                            'name': 'updateSpecialRequirement',
                            'class': 'btn btn-primary',
                        }])|raw }}
                    {% endif %}
                </td>
            </tr>
        </table>
    </div>
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
</form>
