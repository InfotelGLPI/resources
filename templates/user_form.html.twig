{# Rows only: the surrounding form is opened by showFormHeader() and closed by
 # showFormButtons(), which are driven by two different objects here (see
 # GlpiPlugin\Resources\User::showForm()). #}
<input type="hidden" name="idResource" value="{{ resources_id }}">

<tr class="tab_bg_1">
    <td>{{ __('Authentication') }}</td>
    <td>
        {% for line in auth_lines %}
            {{- line }}{% if not loop.last %}<br>{% endif %}
        {% endfor %}
    </td>
</tr>

<tr class="tab_bg_1">
    <td><label for="textfield_phone{{ phone_rand }}">{{ phone_label }}</label></td>
    <td>{{ phone_input|raw }}</td>
    <td>{{ email_label }}</td>
    <td>{{ email_block|raw }}</td>
</tr>
