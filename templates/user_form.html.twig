{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% block form_fields %}
    {# The controller turns the update into a solution on the tickets of that resource. #}
    {{ fields.hiddenField('idResource', resources_id) }}

    {% set auth_html %}
        {% for line in auth_lines %}
            {{- line }}{% if not loop.last %}<br>{% endif %}
        {% endfor %}
    {% endset %}
    {{ fields.htmlField('authtype', auth_html, __('Authentication'), field_options) }}

    {{ fields.textField('phone', item.fields['phone'], phone_label, field_options) }}

    {# UserEmail::showForUser() renders the whole repeatable email block with its own
     # add and remove controls: there is no macro equivalent for it. #}
    {{ fields.htmlField('_useremails', email_block, email_label, field_options) }}
{% endblock %}
