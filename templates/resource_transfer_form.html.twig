{% import 'components/form/basic_inputs_macros.html.twig' as inputs %}

{# Helpdesk form used to declare the transfer of a resource to another entity. It owns its
 # <form>, so it carries the CSRF token itself. #}
{% if not has_resource %}
    <div class="alert alert-info">{{ __('No results found') }}</div>
{% else %}
    <div class="card container" style="min-width: 80%;">
        {% include '@resources/wizard_header.html.twig' with {
            'title': header_title,
            'img': header_img,
        } only %}

        <div class="card-body">
            <form method="post" action="{{ form_action }}">
                <div class="row">
                    <div class="col-md-4 mb-2">{{ resource_label }}</div>
                    <div class="col-md-4 mb-2">{{ resource_name }}</div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-2">{{ __('Current entity', 'resources') }}</div>
                    <div class="col-md-4 mb-2">{{ current_entity }}</div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-2">
                        {{ __('Target entity', 'resources') }} <span class="red">*</span>
                    </div>
                    <div class="col-md-4 mb-2">{{ entity_dropdown|raw }}</div>
                </div>

                <div class="row">
                    <div class="col-md-12 mb-2">
                        <div class="next">
                            {{ inputs.hidden('plugin_resources_resources_id', plugin_resources_resources_id) }}
                            {{ inputs.submit('transferresources', __('Declare a transfer', 'resources'), 1, {
                                'class': 'btn btn-success',
                            }) }}
                        </div>
                    </div>
                </div>

                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            </form>
        </div>
    </div>
{% endif %}
