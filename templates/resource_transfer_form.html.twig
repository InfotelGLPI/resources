{# Helpdesk form used to declare the transfer of a resource to another entity. It owns its
 # <form>. entity_dropdown is a widget rendered by a core helper, which escapes its own
 # attributes and values. #}
<div class="container-lg my-3">
    {% if not has_resource %}
        <div class="alert alert-info"><i class="ti ti-info-circle me-2"></i>{{ __('No results found') }}</div>
    {% else %}
        <form method="post" action="{{ form_action }}" class="card">
            <input type="hidden" name="plugin_resources_resources_id" value="{{ plugin_resources_resources_id }}">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="{{ header_icon }} me-2"></i>{{ header_title }}
                </h3>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-12 col-md-3">{{ resource_label }}</dt>
                    <dd class="col-12 col-md-9">{{ resource_name }}</dd>
                    <dt class="col-12 col-md-3">{{ __('Current entity', 'resources') }}</dt>
                    <dd class="col-12 col-md-9">{{ current_entity }}</dd>
                </dl>
                <div class="row align-items-center">
                    <label class="col-12 col-md-3 col-form-label">
                        {{ __('Target entity', 'resources') }} <span class="required">*</span>
                    </label>
                    <div class="col-12 col-md-9">{{ entity_dropdown|raw }}</div>
                </div>
            </div>
            <div class="card-footer text-end">
                <button type="submit" name="transferresources" value="1" class="btn btn-primary">
                    <i class="ti ti-transfer me-1"></i>{{ __('Declare a transfer', 'resources') }}
                </button>
            </div>
        </form>
    {% endif %}
</div>
