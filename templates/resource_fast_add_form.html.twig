{% import 'components/form/fields_macros.html.twig' as fields %}

{# Massive action sub form: it is rendered inside the form opened by MassiveAction,
 # so no <form> tag and no CSRF token here, both belong to the caller.
 # The itemtype hidden input is emitted by Resource::showMassiveActionsSubForm(). #}
<div class="row">
    {{ fields.htmlField('plugin_resources_contracttypes_id', contracttype_dropdown, contracttype_label, {
        'wrapper_class': '',
        'full_width': true,
    }) }}

    {{ fields.htmlField('users_id_recipient', recipient_dropdown, recipient_label, {
        'wrapper_class': '',
        'full_width': true,
    }) }}

    {{ fields.htmlField('plugin_resources_departments_id', department_dropdown, department_label, {
        'wrapper_class': '',
        'full_width': true,
    }) }}
</div>
