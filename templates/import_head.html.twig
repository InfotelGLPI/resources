{# Table-head fragment: emitted inside a <table> opened by the calling list.
 # The data-resources-stat placeholders are filled by public/scripts/import.js when
 # the #calculate button is clicked. #}
<thead>
    <tr>
        <th colspan="{{ colspan }}">
            {{ title }}
            {% if subtitle is not empty %}
                <br><span class="red">{{ subtitle }}</span>
            {% endif %}
        </th>
    </tr>

    <tr>
        {# `cell.template` is a fixed plugin template name chosen server side. #}
        {% for cell in selector_cells %}
            <td>{{ include(cell.template, cell.params, with_context = false) }}</td>
        {% endfor %}
    </tr>

    {% if show_actions %}
        <tr>
            <td>
                <div class="center">
                    {% if stats is not empty %}
                        <ul>
                            {% for id, label in stats %}
                                <li>{{ label }}&nbsp;&nbsp;&nbsp;<span id="{{ id }}" data-resources-stat="{{ id }}">?</span></li>
                            {% endfor %}
                            <li>
                                <button type="button" id="calculate" class="btn btn-secondary"
                                        data-resources-stats-url="{{ stats_url }}"
                                        data-resources-page="{{ page }}">{{ __('Calculate', 'resources') }}</button>
                            </li>
                        </ul>
                    {% endif %}
                </div>
            </td>
            <td>
                <form name="import_file_form" id="import_file_form" method="post"
                      action="{{ form_action }}" enctype="multipart/form-data">
                    <div class="center">
                        <input type="hidden" name="filename" value="{{ filename }}">
                        {# Button rendered by the core helper, attributes escaped there. #}
                        {{ call('Html::submit', [validate_label, {
                            'name': 'verify-file',
                            'class': 'btn btn-primary',
                        }])|raw }}
                    </div>
                </form>
            </td>
        </tr>
    {% endif %}
</thead>
