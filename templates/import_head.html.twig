{# Table-head fragment: emitted inside a <table> opened by the calling list.
 # The <span id="..."> placeholders are filled by the statistics AJAX call whose
 # script is emitted alongside this template. #}
<thead>
    <tr>
        <th colspan="{{ colspan }}">
            {{ title }}
            {% if subtitle is not empty %}
                <br><span class="red">{{ subtitle }}</span>
            {% endif %}
        </th>
    </tr>

    <tr>
        {% for cell in selector_cells %}
            <td>{{ cell|raw }}</td>
        {% endfor %}
    </tr>

    {% if show_actions %}
        <tr>
            <td>
                <div class="center">
                    {% if stats is not empty %}
                        <ul>
                            {% for id, label in stats %}
                                <li>{{ label }}&nbsp;&nbsp;&nbsp;<span id="{{ id }}">?</span></li>
                            {% endfor %}
                            <li>
                                <button id="calculate" class="button">{{ __('Calculate', 'resources') }}</button>
                            </li>
                        </ul>
                    {% endif %}
                </div>
            </td>
            <td>
                <form name="import_file_form" id="import_file_form" method="post"
                      action="{{ form_action }}" enctype="multipart/form-data">
                    <div class="center">
                        <input type="hidden" name="filename" value="{{ filename }}">
                        {{ call('Html::submit', [validate_label, {
                            'name': 'verify-file',
                            'class': 'btn btn-primary',
                        }])|raw }}
                    </div>
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                </form>
            </td>
        </tr>
    {% endif %}
</thead>
