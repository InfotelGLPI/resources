{# Shared wizard landing menu: the caller passes an already right-filtered list of
 # tiles, so an empty list simply renders the bare table. #}
{{ wizard_header|raw }}

<div class="center">
    <table class="tab_menu" width="30%" cellpadding="5">
        <tr>
            {% for tile in tiles %}
                <td class="tab_td_menu center"{% if tile.colspan is defined %} colspan="{{ tile.colspan }}"{% endif %}>
                    <a href="{{ tile.url }}">
                        {% if tile.icon is defined %}
                            <i class="{{ tile.icon }}" style="font-size:6em"></i>
                        {% else %}
                            <img src="{{ tile.img }}" alt="{{ tile.label }}">
                        {% endif %}
                        <br>{{ tile.label }}
                    </a>
                </td>
            {% endfor %}
        </tr>
    </table>
</div>
