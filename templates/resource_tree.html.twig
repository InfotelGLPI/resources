{# Contract type tree used to filter the resource list. It is served inside an iframe modal,
 # in a page that goes through none of the usual header, so the assets come with it. The tree
 # itself is wired by scripts/resourcetree.js from the data attributes of its container. #}
{{ assets|raw }}

<div class="alert alert-important alert-info d-flex">
    {{ __('Select the contract type', 'resources') }}
</div>
<br>

<a href="{{ target }}?reset=reset" target="_blank" class="text-nowrap" title="{{ __('Show all') }}">
    {{ __('Show all') }}
</a>

<div class="left" style="width:100%">
    <div id="tree_resourcetypes{{ rand }}"
         data-plugin-resources-tree
         data-root-doc="{{ root_doc }}"
         data-more-text="{{ more_text }}"></div>
</div>
