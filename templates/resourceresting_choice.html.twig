{% import 'components/form/fields_macros.html.twig' as fields %}

{# AJAX fragment injected into #plugin_resources_resting by ajax/resourceresting.php.
 # Picking an intercontrat loads its end date field and the submit button. #}
<div class="row">
    {{ fields.dropdownArrayField(
        'plugin_resources_resting_id',
        0,
        elements,
        __('Choosing the intercontrat', 'resources'),
        {
            'is_horizontal': false,
            'field_class': 'col-12',
            'toupdate': [
                {
                    'value_fieldname': 'plugin_resources_resting_id',
                    'to_update': 'plugin_resources_endate_resting',
                    'url': ajax_url,
                    'moreparams': {'action': 'loadEndDateResting'},
                },
                {
                    'value_fieldname': 'plugin_resources_resting_id',
                    'to_update': 'plugin_resources_button_resting',
                    'url': ajax_url,
                    'moreparams': {'action': 'loadButtonResting'},
                },
            ],
        }
    ) }}
</div>
