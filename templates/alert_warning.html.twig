{# Standalone message block used by the front controllers that can only tell the user
 # why the page they asked for cannot be rendered: an inactive plugin, a missing right
 # or a missing configuration.
 #
 # `centered` switches to the plain centered variant used when nothing is actually
 # misconfigured -- there is simply nothing to show yet. #}
{% if centered ?? false %}
    <div class="center">
        <br><br>
        <b>{{ message }}</b>
    </div>
{% else %}
    <div class="alert alert-important alert-warning d-flex">
        <b>{{ message }}</b>
    </div>
{% endif %}
