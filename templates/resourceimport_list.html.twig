<div class="card">
    <div class="card-body">
        <table class="table">
            <thead>
                <tr>
                    <th colspan="2">{{ title }}</th>
                </tr>
                <tr>
                    <th>{{ label_name }}</th>
                    <th>{{ label_value }}</th>
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                    <tr>
                        <td>{{ row.name }}</td>
                        <td>{{ row.value }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
