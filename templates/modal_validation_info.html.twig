{# Confirmation prompt of the resource information validation, included in the modal of
 # resource_validation_form.html.twig.
 # The confirm button is handled by public/scripts/validation.js. #}
<div>{{ __('Do you verify all the information listed on this resource?', 'resources') }}</div>
<br><br>

<button type="button" id="btnAddAnswer" class="btn btn-primary" data-bs-dismiss="modal"
        data-resources-validate="{{ validate_url }}"
        data-resources-id="{{ resources_id }}">
    {{ __('Validate', 'resources') }}
</button>
<button type="button" id="btnClose" class="btn btn-secondary" data-bs-dismiss="modal">
    {{ __('Close', 'resources') }}
</button>
