{# Badge restitution (ResourceBadge::showWizardForm()), driven by an AJAX cascade: picking a
 # resource fills #plugin_resources_badge with its badges, and picking a badge injects the
 # submit button into #plugin_resources_button_restitution (ajax/resourcebadge.php).
 # resource_dropdown is a widget rendered by Resource::dropdown(), which escapes its own
 # attributes and values. #}
<div class="container-lg my-3">
    <form method="post" action="{{ form_action }}" class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="{{ wizard_header.icon }} me-2"></i>{{ wizard_header.title }}
            </h3>
            <div class="card-actions">
                <a href="{{ badges_list_url }}" class="btn btn-ghost-secondary">
                    <i class="ti ti-list-details me-1"></i>{{ badges_list_label }}
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="row mb-3 align-items-center">
                <label class="col-12 col-md-3 col-form-label">{{ resource_label }}</label>
                <div class="col-12 col-md-9">
                    {{ resource_dropdown|raw }}
                </div>
            </div>
            <div id="plugin_resources_badge"></div>
        </div>
        <div class="card-footer text-end" id="plugin_resources_button_restitution"></div>
    </form>
</div>
