{# Massive action sub form, rendered inside the form opened by MassiveAction.
 # `hidden` lists the scalar inputs of the action posted back as hidden fields, `widgets`
 # the core markup of the dropdowns of the action, laid out in a row. #}
{% for name, value in hidden|default([]) %}
    <input type="hidden" name="{{ name }}" value="{{ value }}">
{% endfor %}
{% if label|default('') is not empty %}
    <span class="me-1">{{ label }}</span>
{% endif %}
{% for widget in widgets|default([]) %}
    {# Core markup of Dropdown::show*() and RuleCriteria::dropdownConditions(). #}
    <span class="me-1">{{ widget|raw }}</span>
{% endfor %}
