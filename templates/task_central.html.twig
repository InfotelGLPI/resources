{# Central-page cell: tasks in progress, then the checklists to verify. Each block is the
 # parameter set of central_datatable.html.twig, or null when there is nothing to show. #}
<table class="tab_cadre_central">
    <tr>
        <td>
            {% if tasks is not empty %}
                {{ include('@resources/central_datatable.html.twig', tasks, with_context = false) }}
            {% endif %}

            {% for block in [checklist_todo, checklist_done] %}
                {% if block is not empty %}
                    <div class="mt-3">
                        {{ include('@resources/central_datatable.html.twig', block, with_context = false) }}
                    </div>
                {% endif %}
            {% endfor %}
        </td>
    </tr>
</table>
