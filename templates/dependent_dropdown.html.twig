{# AJAX fragment shared by the endpoints that refresh a dropdown depending on a parent one
 # (ajax/dropdownRank.php, ajax/dropdownSpeciality.php). When the parent has no value there
 # is nothing to list: render an empty placeholder so the field keeps being posted and keeps
 # the id the caller's script targets. `rand` is imposed by that caller. #}
{% if dropdown is not empty %}
    {{ dropdown|raw }}
{% else %}
    <select class="form-select" name="{{ field_name }}" id="dropdown_{{ field_name }}{{ rand }}">
        <option value="0">{{ empty_value }}</option>
    </select>
{% endif %}
