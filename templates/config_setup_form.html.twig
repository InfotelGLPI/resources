<form name="form" method="post" action="{{ form_action }}">
    <div class="center">
        {% if extra_html is defined and extra_html is not empty %}
            {# Modal container built by Ajax::createModalWindow(), a core widget. #}
            {{ extra_html|raw }}
        {% endif %}
        <table class="tab_cadre_fixe">
            <tr class="tab_bg_1">
                <th colspan="3">{{ title }}</th>
            </tr>
            {% for row in rows %}
                <tr class="tab_bg_1">
                    <td>
                        {{ row.label }}
                        {% if row.modal_link is defined %}
                            <br>
                            <a href="#" data-bs-toggle="modal" data-bs-target="{{ row.modal_link.target }}"
                               title="{{ row.modal_link.label }}">{{ row.modal_link.label }}</a>
                        {% endif %}
                    </td>
                    {# Form widget rendered by a core helper (Dropdown, Html::textarea...). #}
                    <td>{{ row.widget|raw }}</td>
                    {% if row.warning is defined and row.warning is not empty %}
                        <td><span class="alert alert-warning">{{ row.warning }}</span></td>
                    {% endif %}
                </tr>
            {% endfor %}
            <tr>
                <td class="tab_bg_2 center" colspan="3">
                    <input type="hidden" name="id" value="1">
                    <button type="submit" name="update_setup" class="btn btn-primary">
                        {{ _x('button', 'Update') }}
                    </button>
                </td>
            </tr>
        </table>
    </div>
</form>
