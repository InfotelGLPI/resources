{% extends 'generic_show_form.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% block form_fields %}
    {{ fields.autoNameField('name', item, __('Name'), withtemplate, field_options) }}

    {{ fields.dropdownYesNo('tag', item.fields['tag'], __('Important', 'resources')) }}

    {{ fields.textField('address', item.fields['address'], __('Link', 'resources')) }}

    {# Itemtype drives an AJAX refresh of the linked-items block below, and its select id
     # is what the generated script observes, so it is rendered outside the macro. #}
    {{ fields.htmlField('itemtype', itemtype_dropdown, __('Itemtype'), {'wrapper_class': ''}) }}

    {# Container the linked items are loaded into; it carries its own bootstrap script. #}
    {{ fields.ajaxField('linkitems', linkitems_js, _n('Item', 'Items', get_plural_number())) }}

    {{ fields.textareaField('comment', item.fields['comment'], __('Description'), {'full_width': true}) }}
{% endblock %}
