{% if can_declare %}
    <div class="center">
        <a href="{{ declare_url }}">{{ __('Declare a new employment', 'resources') }}</a>
    </div>
{% endif %}

{# Standalone form: front/employment.form.php dispatches on add_item, so the
 # generic form buttons component cannot be used here. #}
<div class="center">
    <form method="post" name="addemployment" id="addemployment" action="{{ form_action }}">
        <table class="tab_cadre_fixe">
            <tr>
                <th colspan="2">{{ __('To affect an employment', 'resources') }}</th>
            </tr>
            <tr class="tab_bg_1">
                <td class="center">
                    <input type="hidden" name="items_id" value="{{ items_id }}">
                    <input type="hidden" name="itemtype" value="{{ itemtype }}">
                    {{ employment_label }}
                    {{ employment_dropdown|raw }}
                </td>
                <td class="center">
                    {{ call('Html::submit', [_x('button', 'Add'), {
                        'name': 'add_item',
                        'class': 'btn btn-primary',
                    }])|raw }}
                </td>
            </tr>
        </table>
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    </form>
</div>
