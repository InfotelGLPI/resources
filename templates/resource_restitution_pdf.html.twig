<div class="alert alert-important alert-warning d-flex">
    {{ __("The sales manager is responsible for the complete return of the company's equipment held by the outgoing employee (badge, PC, smartphone, etc.)", 'resources') }}
</div>

<a class="btn btn-warning" href="{{ pdf_url }}" target="_blank" rel="noopener">
    {{ __('Download the restitution form', 'resources') }}
</a>
