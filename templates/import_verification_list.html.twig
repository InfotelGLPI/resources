{# Shared by both verification reports (file vs GLPI, GLPI vs file).
 # `list_header` is the <thead> built by showListHeader(); cell contents are escaped
 # server-side because some of them are links or tooltips, hence |raw. #}
<form name="form" method="post" id="verify" action="{{ form_action }}">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">

    <div class="center">
        {{ pager|raw }}

        <table class="tab_cadre_fixe">
            {{ list_header|raw }}

            {% for entry in entries %}
                <tr>
                    {% for cell in entry.cells %}
                        <td class="center {{ cell.class|default('') }}"
                            {%- if cell.style is defined and cell.style is not empty %} style="{{ cell.style }}"{% endif %}>
                            {{- cell.content|raw -}}
                        </td>
                    {% endfor %}
                </tr>
            {% endfor %}
        </table>
    </div>
</form>
