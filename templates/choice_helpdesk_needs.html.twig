{# The |raw values below are widgets rendered by core helpers (Dropdown::*, Html::input,
 # Html::textarea, Html::showDate*Field, Html::submit...), which escape their own
 # attributes and values. #}

<form method="post" action="{{ form_action }}">
    <div class="center">
        <table class="tab_cadre_fixe">
            <tr>
                <th colspan="4">{{ __('Element(s) to be affected', 'resources') }}</th>
            </tr>
            <tr>
                <th>{{ __('Type') }}</th>
                <th>{{ __('Description') }}</th>
                <th>{{ __('Comments') }}</th>
                {% if canedit %}
                    <th>&nbsp;</th>
                {% endif %}
            </tr>

            {% for row in rows %}
                <tr class="tab_bg_1">
                    <td class="left">{{ row.name }}</td>
                    <td class="left">{{ row.comments|nl2br }}</td>
                    <td class="center">
                        {% if row.comment is not empty %}
                            {{ include('@resources/choice_comment_form.html.twig', {
                                'items_id': row.id,
                                'rand': row.rand,
                                'comment': row.comment,
                                'ajax_url': comment_ajax_url,
                                'raw_comment': row.comment|url_encode,
                            }) }}
                        {% else %}
                            {{ include('@resources/choice_add_comment_form.html.twig', {
                                'items_id': row.id,
                                'rand': row.rand,
                                'ajax_url': add_comment_ajax_url,
                            }) }}
                        {% endif %}
                    </td>
                    {% if canedit %}
                        <td class="center">
                            <button type="submit" form="deleteneed{{ row.id }}{{ row.rand }}" class="btn btn-sm btn-ghost-danger"
                                    title="{{ _x('button', 'Delete permanently') }}">
                                {{ _x('button', 'Delete permanently') }}
                            </button>
                        </td>
                    {% endif %}
                </tr>
            {% endfor %}

            {% if canedit %}
                <tr class="tab_bg_1">
                    <th colspan="4">{{ __('Add a need', 'resources') }} :</th>
                </tr>
                <tr class="tab_bg_1">
                    <td colspan="4" class="center">
                        <input type="hidden" name="plugin_resources_resources_id" value="{{ resources_id }}">
                        {{ choiceitem_dropdown|raw }}
                    </td>
                </tr>
                <tr class="tab_bg_1">
                    <td class="center" colspan="4">
                        {{ call('Html::submit', [_x('button', 'Add'), {
                            'name': 'addhelpdeskitem',
                            'class': 'btn btn-primary',
                        }])|raw }}
                        <input type="hidden" name="plugin_resources_resources_id" value="{{ resources_id }}">
                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                        {% if declaration_button is not empty %}
                            {{ call('Html::submit', [declaration_button.label, {
                                'name': declaration_button.name,
                                'class': 'btn btn-primary',
                            }])|raw }}
                        {% endif %}
                    </td>
                </tr>
            {% endif %}
        </table>
    </div>
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
</form>

{# Delete forms live outside the main form (no nested <form>): each button above targets one. #}
{% if canedit %}
    {% for row in rows %}
        <form id="deleteneed{{ row.id }}{{ row.rand }}" method="post" action="{{ delete_action }}" class="d-none">
            <input type="hidden" name="deletehelpdeskitem" value="1">
            <input type="hidden" name="id" value="{{ row.id }}">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
        </form>
    {% endfor %}
{% endif %}
