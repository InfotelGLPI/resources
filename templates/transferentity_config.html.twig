<form name="form" method="post" action="{{ form_action }}">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    <div class="center">
        <table class="tab_cadre_fixe">
            <tr><th colspan="2">{{ title }}</th></tr>
            <tr class="tab_bg_1">
                <td class="center">
                    {{ entity_label }}&nbsp;{{ entity_dropdown|raw }}
                    {{ entity_group_js|raw }}
                </td>
                <td class="center">
                    <span id="entity_group"></span>
                </td>
            </tr>
            <tr>
                <td class="tab_bg_2 center" colspan="2">
                    <button type="submit" name="add_transferentity" class="btn btn-primary">
                        <i class="ti ti-plus"></i>
                        {{ _x('button', 'Add') }}
                    </button>
                </td>
            </tr>
        </table>
    </div>
</form>
