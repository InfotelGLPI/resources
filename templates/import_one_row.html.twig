{# Cells of one import line, emitted inside a <tr> opened by the caller.
 # Widgets are GLPI dropdowns/inputs rendered server-side, hence |raw. #}
<td class="center" width="10"
    {%- if border_color is not empty %} style="border-left:solid 5px {{ border_color }}"{% endif %}>
    {{- checkbox|raw -}}
</td>

<td class="center">{{ resource_link|raw }}</td>

{% for cell in cells %}
    <td class="center p-0">
        <span>
            {{- cell.hidden|default('')|raw }}
            {% if cell.has_old %}
                {# Old value struck above, new value below. #}
                <ul class="list-unstyled mb-0">
                    <li style="{{ old_style }}">{{ cell.old|raw }}</li>
                    <li style="{{ new_style }}">{{ cell.widget|raw }}</li>
                </ul>
            {% else %}
                {{ cell.widget|raw }}
            {% endif %}
        </span>
    </td>
{% endfor %}
