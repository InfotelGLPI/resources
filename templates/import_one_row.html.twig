{# Cells of one import line, emitted inside a <tr> opened by the caller.
 # Values are escaped here; only `widget` (GLPI dropdowns/date fields rendered by core
 # helpers) and the core checkbox are injected with |raw. #}
<td class="center" width="10"
    {%- if border_color is not empty %} style="border-left:solid 5px {{ border_color }}"{% endif %}>
    {{- checkbox|raw -}}
</td>

<td class="center">
    {%- if resource_url is not empty -%}
        <a href="{{ resource_url }}">{{ resource_id }}</a>
    {%- else -%}
        {{ __('New resource', 'resources') }}
    {%- endif -%}
</td>

{% for cell in cells %}
    <td class="center p-0">
        <span>
            {%- if cell.hidden is not empty %}<input type="hidden" name="{{ cell.hidden.name }}" value="{{ cell.hidden.value }}">{% endif %}
            {% if cell.has_old %}
                {# Old value struck above, new value below. #}
                <ul class="list-unstyled mb-0">
                    <li style="{{ old_style }}">{{ cell.old }}</li>
                    <li style="{{ new_style }}">
                        {%- if cell.text is defined %}{{ cell.text }}{% else %}{{ cell.widget|raw }}{% endif -%}
                    </li>
                </ul>
            {% elseif cell.other is defined %}
                {{ include('@resources/import_other_value.html.twig', cell.other, with_context = false) }}
            {% elseif cell.text is defined %}
                {{ cell.text }}
            {% else %}
                {{ cell.widget|raw }}
            {% endif %}
        </span>
    </td>
{% endfor %}
