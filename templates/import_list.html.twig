{% if entries is empty %}
    {{ include('@resources/import_error_header.html.twig', {'title': error_title}, with_context = false) }}
{% else %}
    <form name="form" method="post" id="import" action="{{ form_action }}" class="card">

        {% for hidden in hidden_inputs %}
            <input type="hidden" name="{{ hidden.name }}" value="{{ hidden.value }}">
        {% endfor %}

        <div class="card-header">
            <div class="d-flex flex-wrap align-items-center gap-3">
                {% for legend in legends %}
                    <a href="{{ legend.url }}" class="d-inline-flex align-items-center text-reset">
                        <span class="d-inline-block rounded-circle me-2"
                              style="width:10px;height:10px;background-color:{{ legend.color }};"></span>{{ legend.label }}
                    </a>
                {% endfor %}
            </div>
            <div class="card-actions">
                {{ include('@resources/import_list_buttons.html.twig', {}, with_context = false) }}
            </div>
        </div>

        <div class="card-body p-0">
            {# Pager rendered by the core (Html::printPager). #}
            {{ pager|raw }}

            <div class="table-responsive">
                <table class="table table-sm table-hover table-vcenter card-table mb-0">
                    <thead>
                        {% include '@resources/import_list_header.html.twig' with {'columns': header_columns} only %}
                    </thead>
                    <tbody>
                        {% for entry in entries %}
                            <tr>{{ include('@resources/import_one_row.html.twig', entry, with_context = false) }}</tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-footer text-end">
            {{ include('@resources/import_list_buttons.html.twig', {}, with_context = false) }}
        </div>
    </form>
{% endif %}
