{% import 'components/form/fields_macros.html.twig' as fields %}

{# Standalone form driven by an AJAX cascade: picking a resource fills
 # #plugin_resources_resting, which in turn fills #plugin_resources_endate_resting
 # and #plugin_resources_button_resting (the submit button is injected there by
 # ajax/resourceresting.php, hence the empty containers below).
 # `rand` is imposed by the caller so the generated JS can observe the dropdown id. #}
<div class="card container" style="min-width: 80%;">
    {{ wizard_header|raw }}

    <div class="card-body">
        <form method="post" action="{{ form_action }}">
            <div class="row">
                {{ fields.dropdownField(
                    resource_class,
                    'plugin_resources_resources_id',
                    0,
                    resource_label,
                    {
                        'rand': rand,
                        'entity': resource_entities,
                        'on_change': 'plugin_resources_load_user_resting()',
                    }
                ) }}
            </div>

            <div id="plugin_resources_resting"></div>

            <div id="plugin_resources_endate_resting"></div>

            <div class="row">
                <div class="col-md-12 mb-2">
                    <div class="preview">
                        <a href="./resourceresting.php">{{ __('List of non contract periods', 'resources') }}</a>
                    </div>
                    <div class="next" id="plugin_resources_button_resting"></div>
                </div>
            </div>

            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
        </form>
    </div>
</div>
