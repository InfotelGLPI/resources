{% if not validated %}
    {# Not a form: the button only opens the confirmation modal, which posts through
     # the validinformation() AJAX call declared alongside this template. #}
    <div class="center">
        <table class="tab_cadre_fixe">
            <tr class="tab_bg_1">
                <th colspan="2">{{ __('Validation', 'resources') }}</th>
            </tr>
            <tr class="tab_bg_1">
                <td colspan="2" class="tab_bg_2 center">
                    <a class="btn btn-primary overflow-hidden text-nowrap" href="#"
                       onclick="popupAnswer.show(); return false;"
                       title="{{ __('Validate', 'resources') }}">{{ __('Validate', 'resources') }}</a>
                </td>
            </tr>
        </table>
    </div>
{% else %}
    {# Standalone form: front/resource.form.php dispatches on synchActiveDirectory. #}
    <form name="form" method="post" action="{{ form_action }}">
        <div class="center">
            <table class="tab_cadre_fixe">
                <tr class="tab_bg_1">
                    <th colspan="2">{{ __('Active Directory synchronization', 'resources') }}</th>
                </tr>
                <tr class="tab_bg_1">
                    <td colspan="2" class="tab_bg_2 center">
                        <input type="hidden" name="plugin_resources_resources_id" value="{{ resources_id }}">
                        {{ call('Html::submit', [sync_label, {
                            'name': 'synchActiveDirectory',
                            'class': 'btn btn-primary',
                        }])|raw }}
                    </td>
                </tr>
            </table>
        </div>
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    </form>
{% endif %}
